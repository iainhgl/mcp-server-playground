# Copy with `make env`, which fills the blank secrets with random values.
# Local-only credentials. Never reuse them anywhere real.

POSTGRES_PASSWORD=
PG_KEYCLOAK_PASSWORD=
PG_IDENTITY_PASSWORD=
PG_PORTAL_PASSWORD=

# Keycloak master-realm admin (https://idp.localtest.me/admin)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

# Password for the seed users alice, bob, carol and dave (SPEC §5)
SEED_USER_PASSWORD=Passw0rd!

# Confidential Keycloak clients (SPEC §6.1)
PORTAL_CLIENT_SECRET=
GATEWAY_SVC_CLIENT_SECRET=

# mitmweb UI at http://localhost:8081
MITM_WEB_PASSWORD=

# Jira DC stub (SPEC §6.5). Admin header for /_stub/* fault injection
STUB_ADMIN_TOKEN=

# The Jira incoming application link (client id/secret). Real Jira generates these.
# Here they're random, and identity reads them (via OpenBao) from phase 3 onwards.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=

# identity service (SPEC §6.3)
# Control-plane admin key (≈ IAM admin on bedrock-agentcore-control)
IDENTITY_ADMIN_TOKEN=
# HMAC key that signs workload access tokens (T3)
IDENTITY_WAT_KEY=
# Service credential the portal uses to call identity (Keycloak client portal-svc)
PORTAL_SVC_CLIENT_SECRET=

# Portal (SPEC §6.4): HMAC key for its session cookie (holds user id + name only, no tokens)
PORTAL_COOKIE_KEY=
# Token ledger DB: insert-only role the services write through
LEDGER_WRITER_PASSWORD=
