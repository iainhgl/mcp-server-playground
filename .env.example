# Copy with `make env`, which fills the blank secrets with random values.
# Local-only credentials. Never reuse them anywhere real.

POSTGRES_PASSWORD=
PG_KEYCLOAK_PASSWORD=
PG_IDENTITY_PASSWORD=
PG_PORTAL_PASSWORD=

# Keycloak master-realm admin (https://idp.localtest.me/admin)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

# Password for the seed users alice, bob, carol and dave (SPEC §5)
SEED_USER_PASSWORD=Passw0rd!

# Confidential Keycloak clients (SPEC §6.1)
PORTAL_CLIENT_SECRET=
GATEWAY_SVC_CLIENT_SECRET=

# mitmweb UI at http://localhost:8081
MITM_WEB_PASSWORD=
