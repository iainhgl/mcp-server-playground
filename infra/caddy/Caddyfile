{
	# Issue every site cert from Caddy's internal CA (export with `make trust`).
	local_certs
	skip_install_trust
	auto_https disable_redirects
}

idp.localtest.me {
	# No discovery rewrites: Keycloak 26.8 natively serves the RFC 8414
	# path-inserted URL MCP clients try first
	# (/.well-known/oauth-authorization-server/realms/playground).
	# Older RH SSO builds may not. See PROGRESS.md discoveries.
	reverse_proxy keycloak:8080
}

gateway.localtest.me {
	# Host header passes through unchanged, so the MCP SDK's DNS-rebinding
	# check sees gateway.localtest.me. SSE responses are flushed automatically.
	reverse_proxy gateway:8000
}

identity.localtest.me {
	# Public only for the browser-facing OAuth callback; the data plane is also reachable here
	# (as in AWS, where it's a public regional endpoint protected by auth).
	reverse_proxy identity:8001
}

portal.localtest.me {
	reverse_proxy portal:3000
}

jira.localtest.me {
	reverse_proxy jira:2990
}

confluence.localtest.me {
	reverse_proxy confluence:1990
}
