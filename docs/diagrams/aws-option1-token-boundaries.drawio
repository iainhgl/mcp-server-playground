<mxfile host="app.diagrams.net"><diagram name="Option 1 - token boundaries" id="aws-option1-token-boundaries.drawio"><mxGraphModel dx="1260" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="AWS option 1: Cognito (federated to IAM Identity Center) in front of AgentCore Gateway - which token crosses which boundary" style="rounded=0;whiteSpace=wrap;html=0;text;strokeColor=none;fillColor=none;fontColor=#1A1A1A;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c4" value="User device" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F7F7F7;strokeColor=#999999;dashed=1;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="270" height="470" as="geometry"/></mxCell><mxCell id="c5" value="AWS identity (no enterprise IdP)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F7F7F7;strokeColor=#999999;dashed=1;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="330" height="190" as="geometry"/></mxCell><mxCell id="c6" value="AWS account - your app" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F7F7F7;strokeColor=#999999;dashed=1;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="230" height="190" as="geometry"/></mxCell><mxCell id="c7" value="AWS account - Amazon Bedrock AgentCore" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F7F7F7;strokeColor=#999999;dashed=1;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="290" width="600" height="330" as="geometry"/></mxCell><mxCell id="c8" value="Client / on-prem network" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F7F7F7;strokeColor=#999999;dashed=1;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="290" width="250" height="330" as="geometry"/></mxCell><mxCell id="c9" value="Browser&#xa;(H1 sign-in, H2 Atlassian consent,&#xa;H3 return)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c10" value="MCP client&#xa;(Claude Code)&#xa;holds T1, T1r" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="190" height="70" as="geometry"/></mxCell><mxCell id="c11" value="IAM Identity Center&#xa;(AWS access portal&#xa;users)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="350" y="110" width="130" height="90" as="geometry"/></mxCell><mxCell id="c12" value="Amazon Cognito&#xa;user pool&#xa;(OIDC, no DCR:&#xa;pre-registered client)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="510" y="110" width="130" height="90" as="geometry"/></mxCell><mxCell id="c13" value="Return-URL app&#xa;(Lambda / ECS)&#xa;IAM role for SigV4" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="190" height="90" as="geometry"/></mxCell><mxCell id="c14" value="AgentCore Gateway&#xa;CUSTOM_JWT authorizer&#xa;(Cognito discovery URL)&#xa;targets: jira, confluence" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="360" y="360" width="170" height="90" as="geometry"/></mxCell><mxCell id="c15" value="AgentCore Identity&#xa;workload identity (gateway)&#xa;token vault: T4/T5 per&#xa;(workload, user sub, provider)&#xa;callback endpoint (regional)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="620" y="340" width="280" height="110" as="geometry"/></mxCell><mxCell id="c16" value="AWS KMS&#xa;(vault encryption)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="620" y="500" width="130" height="70" as="geometry"/></mxCell><mxCell id="c17" value="Secrets Manager&#xa;T8: Atlassian&#xa;client secrets" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="770" y="500" width="130" height="70" as="geometry"/></mxCell><mxCell id="c18" value="Jira DC&#xa;(OAuth 2.0 provider +&#xa;REST API)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1010" y="350" width="190" height="70" as="geometry"/></mxCell><mxCell id="c19" value="Confluence DC&#xa;(separate app link,&#xa;separate consent)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1010" y="470" width="190" height="70" as="geometry"/></mxCell><mxCell id="c20" value="opens browser" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="c10" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="H1: OIDC auth code + PKCE" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;startArrow=block;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="SAML assertion&#xa;(federation)" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;startArrow=block;" edge="1" parent="1" source="c12" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="code -&gt; T1 + T1r&#xa;(token endpoint)" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;startArrow=block;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="MCP + Bearer T1&#xa;(Cognito access token)" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="T1 -&gt; T3 (workload token)&#xa;T3 -&gt; T4  (internal)" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;startArrow=block;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="wrap / unwrap&#xa;data keys" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;startArrow=block;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="read T8" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="Bearer T4 only&#xa;(never T1)" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;" edge="1" parent="1" source="c14" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="code + verifier + T8 -&gt; T4/T5&#xa;refresh T5&#xa;(R1: reachable from AWS?)" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;startArrow=block;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="H2: login + consent" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="c9" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="callback ?code&amp;state" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="c9" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="H3: return ?session_id" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="silent OIDC -&gt; T2" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;startArrow=block;" edge="1" parent="1" source="c13" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="CompleteResourceTokenAuth&#xa;(SigV4 + userToken T2)" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="Bearer T4" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="Tokens&#xa;SAML   Identity Center -&gt; Cognito assertion (browser-carried). Proves who the AWS user is.&#xa;T1     Cognito access token (JWT). Held by the MCP client, sent to the Gateway. Checked: signature, iss, client_id, scope.&#xa;T1r    Cognito refresh token. MCP client only.&#xa;T2     Cognito token for the return-URL app (silent SSO). Used once for binding, never stored.&#xa;T3     AgentCore workload access token: binds workload (gateway) + user (T1 sub). Internal to AgentCore.&#xa;T4/T5  Atlassian access / refresh tokens. Only in AgentCore Identity's token vault (KMS); T4 lent to the Gateway per call.&#xa;T8     Atlassian OAuth client id/secret (app link) in Secrets Manager.&#xa;SigV4  Return-URL app's IAM role signing the CompleteResourceTokenAuth call.&#xa;&#xa;To verify with AWS: Cognito &lt;- Identity Center SAML federation; Claude Code with a pre-registered client id; Gateway allowedClients/allowedScopes for Cognito access tokens (no aud); R1 network path to on-prem Jira." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#EEEEEE;strokeColor=#999999;fontColor=#1A1A1A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="1210" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
