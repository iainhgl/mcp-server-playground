<mxfile host="app.diagrams.net"><diagram name="Option 2 - token boundaries" id="aws-option2-token-boundaries.drawio"><mxGraphModel dx="1270" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1270" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="AWS option 2: MCP Proxy for AWS (SigV4) -&gt; AgentCore Gateway (AWS_IAM inbound) - which credential or token crosses which boundary.  ASSUMES A1-A4 (see legend)" style="rounded=0;whiteSpace=wrap;html=0;text;strokeColor=none;fillColor=none;fontColor=#1A1A1A;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="30" as="geometry"/></mxCell><mxCell id="c4" value="User device" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F7F7F7;strokeColor=#999999;dashed=1;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="520" as="geometry"/></mxCell><mxCell id="c5" value="AWS sign-in (native IAM users)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F7F7F7;strokeColor=#999999;dashed=1;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="60" width="260" height="190" as="geometry"/></mxCell><mxCell id="c6" value="AWS account - Amazon Bedrock AgentCore" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F7F7F7;strokeColor=#999999;dashed=1;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="290" width="600" height="330" as="geometry"/></mxCell><mxCell id="c7" value="Client / on-prem network" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F7F7F7;strokeColor=#999999;dashed=1;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="290" width="240" height="330" as="geometry"/></mxCell><mxCell id="c8" value="Browser&#xa;(aws login sign-in, H2 Atlassian consent)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="240" height="70" as="geometry"/></mxCell><mxCell id="c9" value="MCP client (Claude Code)&#xa;no AWS keys, no tokens" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="50" y="230" width="240" height="60" as="geometry"/></mxCell><mxCell id="c10" value="MCP Proxy for AWS (stdio)&#xa;signs every request with C1&#xa;(SigV4, service bedrock-agentcore)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="50" y="340" width="240" height="80" as="geometry"/></mxCell><mxCell id="c11" value="Loopback return helper&#xa;(custom, http://localhost:&lt;port&gt;)&#xa;binds consent with C1  [A2, A3]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="240" height="80" as="geometry"/></mxCell><mxCell id="c12" value="AWS Sign-In / aws login&#xa;IAM user + MFA&#xa;-&gt; C1 temporary credentials&#xa;(~/.aws/login/cache)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="390" y="110" width="200" height="100" as="geometry"/></mxCell><mxCell id="c13" value="AgentCore Gateway&#xa;AWS_IAM inbound&#xa;verifies SigV4 + IAM policy&#xa;caller = IAM user ARN  [A1]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="390" y="360" width="180" height="100" as="geometry"/></mxCell><mxCell id="c14" value="AgentCore Identity&#xa;token vault: T4/T5 per&#xa;(workload, IAM principal, provider)  [A1]&#xa;callback endpoint (regional)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="640" y="340" width="290" height="110" as="geometry"/></mxCell><mxCell id="c15" value="AWS KMS&#xa;(vault encryption)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="640" y="500" width="135" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Secrets Manager&#xa;T8: Atlassian&#xa;client secrets" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="795" y="500" width="135" height="70" as="geometry"/></mxCell><mxCell id="c17" value="Jira DC&#xa;(OAuth 2.0 provider +&#xa;REST API)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1030" y="350" width="190" height="70" as="geometry"/></mxCell><mxCell id="c18" value="Confluence DC&#xa;(separate app link,&#xa;separate consent)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1030" y="470" width="190" height="70" as="geometry"/></mxCell><mxCell id="c19" value="C0: console sign-in&#xa;(IAM user password + MFA)" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;startArrow=block;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="C1 cached locally" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="c12" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="MCP over stdio&#xa;(no credentials)" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;startArrow=block;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="MCP + SigV4 (C1)&#xa;per-request signature,&#xa;not a bearer token" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="caller principal -&gt; T3&#xa;T3 -&gt; T4  (internal)  [A1]" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;startArrow=block;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="wrap / unwrap&#xa;data keys" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;startArrow=block;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="read T8" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="Bearer T4 only" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="code + verifier + T8 -&gt; T4/T5&#xa;refresh T5&#xa;(R1: reachable from AWS?)" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;startArrow=block;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="Bearer T4" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="c13" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="opens consent URL" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="H2: login + consent" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="c8" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="callback ?code&amp;state" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="c8" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="302 localhost ?session_id" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="CompleteResourceTokenAuth&#xa;SigV4 (C1): signer == session user  [A3]" style="edgeStyle=none;html=0;strokeColor=#333333;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;endArrow=block;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="Credentials and tokens&#xa;C0     Console sign-in (IAM user + MFA) in the browser, via `aws login`. Native AWS login, no enterprise IdP.&#xa;C1     Temporary IAM credentials from aws login (auto-rotated, cached on disk). Used only by the proxy / helper to sign.&#xa;SigV4  Per-request signature made with C1. Proves the caller's IAM principal. NOT a bearer token, nothing to replay.&#xa;T3     AgentCore workload access token: binds workload (gateway) + user (= IAM principal, A1). Internal.&#xa;T4/T5  Atlassian access / refresh tokens. Only in the token vault (KMS); T4 lent to the Gateway per call.&#xa;T8     Atlassian OAuth client id/secret (app link) in Secrets Manager.&#xa;&#xa;ASSUMPTIONS (not documented by AWS - confirm before relying on them)&#xa;A1  AWS_IAM inbound + OAuth authorization-code outbound is supported, and the vault user id = the caller's IAM&#xa;    principal (IAM user ARN, or SourceIdentity / session name for roles). Shared users/roles would collapse people.&#xa;A2  The workload's allowed return URLs accept a loopback URL (http://localhost:&lt;port&gt;/...).&#xa;A3  CompleteResourceTokenAuth called with IAM credentials binds to the SIGNER, so only the same person can finish&#xa;    a consent they started (the browser has no IdP session to prove it). The loopback helper is custom code.&#xa;A4  MCP Proxy for AWS passes URL elicitations / InputRequiredResult through to the client unchanged." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#EEEEEE;strokeColor=#999999;fontColor=#1A1A1A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="1220" height="270" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
